    "release-eng:test": "node release-engineering/run-release-engineering-lab.js",
    "release-eng:test:unit": "node --test release-engineering/tests/*.test.js",
    "db-migration:test": "node db-migration-testing/run-db-migration-lab.js",
    "db-migration:test:unit": "node --test db-migration-testing/tests/*.test.js",
    "multi-tenancy:test": "node multi-tenancy-isolation/run-multi-tenancy-lab.js",
