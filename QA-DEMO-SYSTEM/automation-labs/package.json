{
  "name": "automation-labs",
  "version": "0.1.0",
  "private": true,
  "description": "QA Demo System — Phase 10 Automation Learning Labs (Selenium WebDriver; JMeter plans run through a real fail-gate wrapper, see jmeter/scripts/run-jmeter.js); Part 2 AI Systems Testing lab (deterministic mock-first, see ai-systems/README.md); Part 2 Chaos/Reliability lab (deterministic fault injection, see chaos-reliability/README.md); Part 2 Privacy Testing lab (see privacy-testing/README.md); Part 2 Property-Based & Fuzz Testing lab (see property-and-fuzz-testing/README.md); Part 2 Service Virtualization & Contract Testing lab (see service-virtualization/README.md); Part 2 Mutation Testing lab (see mutation-testing/README.md); Part 2 Testcontainers lab (see testcontainers-lab/README.md); Part 2 Data Engineering lab (see data-engineering/README.md); Part 2 Distributed Messaging lab (see distributed-messaging/README.md); Part 2 Supply Chain Security lab (see supply-chain-security/README.md); Part 2 Compatibility Testing lab (see compatibility-testing/README.md)",
  "scripts": {
    "selenium:test": "node selenium/tests/login-flow.test.js",
    "selenium:test:parallel": "node selenium/scripts/run-parallel.js",
    "jmeter:test": "node jmeter/scripts/run-jmeter.js",
    "jmeter:test:gate-unit": "node --test jmeter/scripts/run-jmeter.test.js",
    "ai:test": "node ai-systems/run-ai-lab.js",
    "ai:test:unit": "node --test ai-systems/tests/*.test.js",
    "chaos:test": "node chaos-reliability/run-chaos-lab.js",
    "chaos:test:unit": "node --test chaos-reliability/tests/*.test.js",
    "privacy:test": "node privacy-testing/run-privacy-lab.js",
    "privacy:test:unit": "node --test privacy-testing/tests/pii-scanner-unit.test.js privacy-testing/tests/data-subject-rights.test.js",
    "property-fuzz:test": "node property-and-fuzz-testing/run-property-and-fuzz-lab.js",
    "property-fuzz:test:unit": "node --test property-and-fuzz-testing/tests/property-testing-framework.test.js property-and-fuzz-testing/tests/products-service-properties.test.js",
    "virtualization:test": "node service-virtualization/run-virtualization-lab.js",
    "virtualization:test:unit": "node --test service-virtualization/tests/stub-server.test.js service-virtualization/tests/consumer-contract.test.js",
    "mutation:test": "node mutation-testing/run-mutation-lab.js",
    "mutation:test:unit": "node --test mutation-testing/tests/mutation-engine.test.js",
    "testcontainers:test": "node testcontainers-lab/run-testcontainers-lab.js",
    "testcontainers:test:unit": "node --test testcontainers-lab/tests/classify-docker-error.test.js",
    "data-eng:test": "node data-engineering/run-data-engineering-lab.js",
    "data-eng:test:unit": "node --test data-engineering/tests/*.test.js",
    "messaging:test": "node distributed-messaging/run-distributed-messaging-lab.js",
    "messaging:test:unit": "node --test distributed-messaging/tests/broker.test.js distributed-messaging/tests/idempotent-consumer.test.js",
    "supply-chain:test": "node supply-chain-security/run-supply-chain-security-lab.js",
    "supply-chain:test:unit": "node --test supply-chain-security/tests/*.test.js",
    "compatibility:test": "node compatibility-testing/run-compatibility-lab.js",
    "compatibility:test:unit": "node --test compatibility-testing/tests/compatibility-check.test.js"
  },
  "devDependencies": {
    "selenium-webdriver": "^4.49.0",
    "ajv": "^8.20.0",
    "testcontainers": "^10.13.0"
  }
}
