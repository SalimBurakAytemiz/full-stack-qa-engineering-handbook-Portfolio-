    {
      "name": "3. Orders — Ownership & Cross-User",
      "item": [
        {
          "name": "Create Order (User A) -> 201 PAID",
          "id": "36e80f87-f3fa-4dde-8a1e-14ddcfa4eca2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"product_id\": 1, \"quantity\": 1 }],\n  \"payment_token\": \"TEST-CARD-APPROVED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] },
            "description": "shared/test-data/payment-test-patterns.json — TEST-CARD-APPROVED (deterministic, fake payment)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Order is PAID', function () {",
                  "  pm.expect(json.order.status).to.eql('PAID');",
                  "});",
                  "pm.collectionVariables.set('userAOrderId', json.order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order (User A, owner) -> 200",
          "id": "be341add-387e-4bf0-b42e-a6e001e0e560",
