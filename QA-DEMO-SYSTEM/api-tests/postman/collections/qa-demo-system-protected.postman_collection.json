    {
      "name": "4. Notifications — Ownership & Cross-User",
      "item": [
        {
          "name": "Get Notifications (User A) — own order_id present",
          "id": "75171df6-0bb7-4b32-8ad9-cf8dafd5afe4",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const notifications = pm.response.json().notifications;",
                  "const userAOrderId = Number(pm.collectionVariables.get('userAOrderId'));",
                  "pm.test('User A sees a notification for their own PAID order', function () {",
                  "  const found = notifications.some((n) => n.order_id === userAOrderId);",
                  "  pm.expect(found, 'expected a notification with order_id=' + userAOrderId).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Notifications (User B) — User A's order_id must NOT leak",
          "id": "61baadc4-3ee3-4203-98b4-db7118b61541",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userBToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] },
            "description": "Doğru assertion data-state-independent'tir: 'boş liste' değil, 'User A'nın order_id'si asla dönmez'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const notifications = pm.response.json().notifications;",
                  "const userAOrderId = Number(pm.collectionVariables.get('userAOrderId'));",
                  "pm.test('User B never sees a notification for User A order_id (no cross-user leakage)', function () {",
                  "  const leaked = notifications.some((n) => n.order_id === userAOrderId);",
                  "  pm.expect(leaked, 'User A order_id leaked into User B notifications').to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Notifications (no token) -> 401",
          "id": "c7ea48c9-d2f8-4d74-87de-a38ba1bc6849",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
