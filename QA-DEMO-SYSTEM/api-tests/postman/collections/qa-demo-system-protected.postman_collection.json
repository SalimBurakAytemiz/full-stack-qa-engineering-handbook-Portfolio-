            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{userAOrderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{userAOrderId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order id matches (owner can see own order)', function () {",
                  "  pm.expect(pm.response.json().order.id).to.eql(Number(pm.collectionVariables.get('userAOrderId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order (User B, cross-user) -> 404 (ownership denial, not 403)",
