{
  "info": {
    "_postman_id": "810f10ba-4f29-4fef-877e-1626ec3a76d2",
    "name": "QA Demo System - Protected API / Auth & Authorization (P5.3)",
    "description": "P5.3 — Authentication & Authorization API Tests. Kapsam: requireAuth middleware'i (no/invalid/malformed/valid token), ownership isolation ve cross-user access (Orders, Notifications). Business/functional senaryolar (order creation kuralları, stock, payment kombinasyonları, notification business akışı) bu koleksiyonun KAPSAMI DIŞINDADIR — bkz. 07-API-TESTING/README.md ve api-tests/README.md. Token'lar yalnızca runtime'da collection variable olarak tutulur, dosyaya yazılmaz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication Gate (No Token)",
      "item": [
        {
          "name": "GET /api/orders/1 — no Authorization header -> 401",
          "id": "19e3db92-0441-4d52-9894-749d0c0e9e1b",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/1", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1"] },
            "description": "P5.3'ün ilk uygulama adımı — tek gate request. Bu PASS olmadan koleksiyonun geri kalanına geçilmedi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "  pm.response.to.have.header('Content-Type', 'application/json; charset=utf-8');",
                  "});",
                  "pm.test('Error body: Yetkilendirme gerekli', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('error', 'Yetkilendirme gerekli');",
                  "  pm.expect(Object.keys(json)).to.eql(['error']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Token Bootstrap",
      "item": [
        {
          "name": "Login as User A (test.active01)",
          "id": "4a53bca0-669f-4208-a505-2a253f4f2623",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.active01@example.com\",\n  \"password\": \"ValidPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Synthetic/deterministic test credential — shared/test-data/auth-users.json. USER A."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Response has token and user.id', function () {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user.id).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('userAToken', json.token);",
                  "pm.collectionVariables.set('userAId', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User B (test.active02)",
          "id": "e275af16-5d24-47a4-a9f1-4992ea226d09",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.active02@example.com\",\n  \"password\": \"ValidPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Synthetic/deterministic test credential — shared/test-data/auth-users.json. USER B."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Response has token and user.id', function () {",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user.id).to.be.a('number');",
                  "});",
                  "pm.test('User B is a different user than User A', function () {",
                  "  pm.expect(json.user.id).to.not.eql(pm.collectionVariables.get('userAId'));",
                  "});",
                  "pm.collectionVariables.set('userBToken', json.token);",
                  "pm.collectionVariables.set('userBId', json.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
