        {
          "name": "Verify exactly one new, correlated notification appears (order.paid)",
          "id": "1b90b1c6-7800-4a96-bbaa-812b9a06d7e8",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications"
              ]
            },
            "description": "Kaynak koddan doğrulandı: notifications.service.js createNotificationFromOrderPaidEvent() — id, type, message, order_id, is_read, created_at alanları. user_id response'da YOK (listNotificationsForUser() sorgusunda seçilmiyor). is_read gerçek çalıştırmada INTEGER 0 döner, boolean false DEĞİL — tahmin edilmedi, curl ile ampirik doğrulandı."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type is application/json', function () { pm.response.to.have.header('Content-Type', 'application/json; charset=utf-8'); });",
                  "const json = pm.response.json();",
                  "const before = pm.collectionVariables.get('notifBeforeCount');",
                  "const orderId = pm.collectionVariables.get('gateOrderId');",
                  "pm.test('Notification count increased by exactly 1', function () { pm.expect(json.notifications.length).to.eql(before + 1); });",
                  "const matches = json.notifications.filter(function (n) { return n.order_id === orderId; });",
                  "pm.test('Exactly one notification correlated to this order_id', function () { pm.expect(matches.length).to.eql(1); });",
                  "const n = matches[0];",
                  "pm.test('Correlated notification has correct contract fields (type/message/is_read/id/created_at)', function () {",
                  "  pm.expect(n.type).to.eql('order.paid');",
                  "  pm.expect(n.message).to.eql('Order #' + orderId + ' payment approved.');",
                  "  pm.expect(n.is_read).to.eql(0);",
                  "  pm.expect(typeof n.id).to.eql('number');",
                  "  pm.expect(typeof n.created_at).to.eql('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
