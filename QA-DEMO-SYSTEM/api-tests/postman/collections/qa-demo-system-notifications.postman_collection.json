              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const gateOrderId = pm.collectionVariables.get('gateOrderId');",
                  "const secondOrderId = pm.collectionVariables.get('secondOrderId');",
                  "const gateMatches = json.notifications.filter(function (n) { return n.order_id === gateOrderId; });",
                  "const secondMatches = json.notifications.filter(function (n) { return n.order_id === secondOrderId; });",
                  "pm.test('Exactly one notification for the first (gate) order — not duplicated', function () { pm.expect(gateMatches.length).to.eql(1); });",
                  "pm.test('Exactly one notification for the second order — distinct, not merged', function () { pm.expect(secondMatches.length).to.eql(1); });",
                  "pm.test('The two notifications are different records', function () { pm.expect(gateMatches[0].id).to.not.eql(secondMatches[0].id); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
