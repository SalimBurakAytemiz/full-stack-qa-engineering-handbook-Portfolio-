                  "});",
                  "const product = pm.response.json().product;",
                  "pm.test('Requested id matches response id', function () {",
                  "  pm.expect(product.id).to.eql(2);",
                  "});",
                  "pm.test('Out-of-stock product: stock_quantity === 0 and in_stock === false', function () {",
                  "  pm.expect(product.stock_quantity).to.eql(0);",
                  "  pm.expect(product.in_stock).to.eql(false);",
                  "});"
                ]
              }
            }
