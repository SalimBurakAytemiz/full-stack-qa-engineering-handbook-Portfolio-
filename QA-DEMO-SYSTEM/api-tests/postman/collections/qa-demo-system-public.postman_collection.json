    {
      "name": "Products",
      "item": [
        {
          "name": "List",
          "id": "3d3029de-8d24-4d68-ae18-0a526e7abb1f",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Public endpoint: no Authorization header required/sent', function () {",
                  "  pm.expect(pm.request.headers.has('Authorization')).to.eql(false);",
                  "});",
                  "const products = pm.response.json().products;",
                  "pm.test('At least the 4 deterministic seed products are present', function () {",
                  "  pm.expect(products.length).to.be.at.least(4);",
                  "});",
                  "pm.test('Data quality: stock_quantity/in_stock consistency for every product', function () {",
                  "  products.forEach((p) => {",
                  "    const expected = p.stock_quantity > 0;",
                  "    pm.expect(p.in_stock, 'product id=' + p.id + ' stock_quantity=' + p.stock_quantity + ' in_stock=' + p.in_stock).to.eql(expected);",
                  "  });",
                  "});",
                  "pm.test('Data quality: no duplicate product id, no empty name, no negative stock', function () {",
                  "  const ids = products.map((p) => p.id);",
                  "  pm.expect(new Set(ids).size, 'duplicate id found').to.eql(ids.length);",
                  "  products.forEach((p) => {",
                  "    pm.expect(p.name, 'product id=' + p.id + ' has empty name').to.be.a('string').and.not.empty;",
                  "    pm.expect(p.stock_quantity, 'product id=' + p.id + ' has negative stock').to.be.at.least(0);",
                  "  });",
                  "});",
                  "const productOne = products.find((p) => p.id === 1);",
                  "pm.collectionVariables.set('productOneFromList', JSON.stringify(productOne));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Detail - In Stock (deterministic existing product)",
          "id": "c1a28ead-6542-4f2a-a777-63352b04575d",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "id=1 — shared/test-data/products.json'daki deterministic, stokta olan ürün (stock_quantity=25)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const product = pm.response.json().product;",
                  "pm.test('Requested id matches response id', function () {",
                  "  pm.expect(product.id).to.eql(1);",
                  "});",
                  "pm.test('In-stock product: stock_quantity > 0 and in_stock === true', function () {",
                  "  pm.expect(product.stock_quantity).to.be.above(0);",
                  "  pm.expect(product.in_stock).to.eql(true);",
                  "});",
                  "pm.test('List -> Detail consistency (same underlying row)', function () {",
                  "  const fromListRaw = pm.collectionVariables.get('productOneFromList');",
                  "  pm.expect(fromListRaw, 'List request must run before this one to populate productOneFromList').to.not.be.undefined;",
                  "  const fromList = JSON.parse(fromListRaw);",
                  "  pm.expect(product).to.eql(fromList);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Detail - Out of Stock",
          "id": "6103cc30-2762-4bbe-a2f1-8e3af1f4c638",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
