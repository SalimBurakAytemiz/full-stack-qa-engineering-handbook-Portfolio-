{
  "name": "qa-demo-system-api-tests",
  "version": "0.1.0",
  "private": true,
  "description": "QA Demo System API Tests — Phase 5 (Postman/Newman collection runner)",
  "scripts": {
    "api:test:postman": "node scripts/run-schema-validation.js",
    "api:test:postman:basic": "newman run postman/collections/qa-demo-system-public.postman_collection.json -e postman/environments/local.postman_environment.json",
    "api:test:schema:negative-proof": "node scripts/schema-negative-proof.js",
    "api:test:auth": "newman run postman/collections/qa-demo-system-protected.postman_collection.json -e postman/environments/local.postman_environment.json",
    "api:test:orders-payment": "node scripts/run-orders-schema-validation.js",
    "api:test:orders-payment:basic": "newman run postman/collections/qa-demo-system-orders-payment.postman_collection.json -e postman/environments/local.postman_environment.json",
    "api:test:notifications": "node scripts/run-notifications-schema-validation.js",
    "api:test:notifications:basic": "newman run postman/collections/qa-demo-system-notifications.postman_collection.json -e postman/environments/local.postman_environment.json",
    "api:test:db": "node scripts/run-api-db-validation.js",
    "api:report:public": "node scripts/generate-html-report.js public",
    "api:report:auth": "node scripts/generate-html-report.js auth",
    "api:report:products": "node scripts/generate-html-report.js products",
    "api:report:orders": "node scripts/generate-html-report.js orders",
    "api:report:notifications": "node scripts/generate-html-report.js notifications",
    "api:report:all": "node scripts/generate-html-report.js all"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
