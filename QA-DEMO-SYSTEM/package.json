{
  "name": "qa-demo-system",
  "version": "0.1.0",
  "private": true,
  "description": "QA Demo System — Phase 4 demo application (working QA test target)",
  "workspaces": [
    "backend",
    "api-tests",
    "web-tests",
    "automation-labs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
