{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.internal/lab.schema.json",
  "title": "Executable lab catalog entry",
  "type": "object",
  "required": ["id", "label", "maturity", "path"],
  "properties": {
    "id": { "type": "string", "pattern": "^lab\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
    "label": { "type": "string", "minLength": 1 },
    "maturity": {
      "enum": ["L0_PLANNED", "L1_IMPLEMENTED", "L2_TESTED", "L3_AUTOMATED", "L4_CI_VERIFIED", "L5_EVIDENCE_VERIFIED"],
      "description": "Section 30 of the transformation spec. Maturity must not exceed what real evidence supports."
    },
    "path": {
      "type": "string",
      "description": "Repository-relative path to the lab's real code/tests."
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
    },
    "related_domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^domain\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$" }
    },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
