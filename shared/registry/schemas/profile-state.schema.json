{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.internal/profile-state.schema.json",
  "title": "Digital Twin profile entry",
  "description": "Validates 01-SALIM-BURAK-DIGITAL-TWIN/registry/profile.yaml — the single root fact for the personal profile (Section 8). Deliberately distinct from tool.schema.json / domain.schema.json: this is the ONE person, not a catalog list.",
  "type": "object",
  "required": ["schema_version", "id", "last_updated", "source", "identity", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": {
      "type": "string",
      "pattern": "^profile\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
    },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string" },
    "identity": {
      "type": "object",
      "required": ["name", "role", "years_of_experience"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "years_of_experience": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "summary": { "type": "string", "minLength": 1 },
    "coverage_stack": {
      "type": "array",
      "items": { "type": "string" }
    },
    "testing_types_practiced_professionally": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related": { "type": "object" }
  },
  "additionalProperties": true
}
